{
  "scenario_id": "ja-en-native-accessibility-001",
  "fixture": "NativeAccessibilityFixture.swift",
  "languages": ["ja", "en"],
  "capture_scope": "single_native_window",
  "policy": "strict_reveal",
  "coordinate_status": "ax_observed",
  "sensitive_labels": [
    "billing_failure_title",
    "customer_name",
    "email_and_auth_code",
    "phone_and_session",
    "confirmation_dialog",
    "transient_popover",
    "ime_composition_field",
    "canvas_text_without_ax_text_element",
    "rapid_sensitive_state_burst",
    "rapid_sensitive_input_update"
  ],
  "acceptance": {
    "minimum_ax_observations": 4,
    "minimum_vision_observations": 1,
    "must_not_store_recognized_text": true,
    "must_destroy_unknown_client_area": true,
    "must_exercise_canvas_text": true,
    "must_observe_native_modal_when_triggered": true,
    "sheet_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_SHEET=1",
    "hide_window_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_HIDE_WINDOW=1",
    "resize_window_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_RESIZE_WINDOW=1",
    "must_observe_native_popover_when_triggered": true,
    "popover_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_POPOVER=1",
    "must_exercise_native_ime_when_available": true,
    "title_change_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_TITLE_CHANGE=1",
    "foreground_switch_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_FOREGROUND_SWITCH=1",
    "same_app_focus_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_SAME_APP_WINDOW_FOCUS=1",
    "rapid_burst_interval_ms": 50,
    "rapid_burst_requires_full_frame_strict_shield": true,
    "rapid_input_requires_full_frame_strict_shield": true,
    "rapid_input_autorun_environment": "DROP_SQUASH_FIXTURE_AUTORUN_INPUT_BURST=1",
    "rapid_input_delay_environment": "DROP_SQUASH_FIXTURE_INPUT_BURST_DELAY_SECONDS",
    "rapid_input_cycles_environment": "DROP_SQUASH_FIXTURE_INPUT_BURST_CYCLES",
    "must_fail_closed_if_output_verification_fails": true,
    "truth_environment": "DROP_SQUASH_FIXTURE_TRUTH_PATH",
    "rapid_input_truth_environment": "DROP_SQUASH_FIXTURE_TRUTH_INCLUDE_INPUT=1; emits monotonic per-state rectangles",
    "automatic_scenario_delay_seconds": 10
  },
  "scenario_contracts": {
    "baseline": { "classification": "strict_black_publish", "final_artifact": "required" },
    "rapid-burst": { "classification": "strict_black_publish", "final_artifact": "required" },
    "input-burst": { "classification": "strict_black_publish", "final_artifact": "required" },
    "popover": { "classification": "strict_black_publish", "final_artifact": "required" },
    "sheet": { "classification": "strict_black_publish", "final_artifact": "required" },
    "title": { "classification": "detected_but_not_covered", "final_artifact": "allowed" },
    "hide": { "classification": "fail_closed", "final_artifact": "forbidden" },
    "resize": { "classification": "fail_closed", "final_artifact": "forbidden" },
    "move": { "classification": "fail_closed", "final_artifact": "forbidden" },
    "move-return": { "classification": "fail_closed", "final_artifact": "forbidden" },
    "focus-loss": { "classification": "fail_closed", "final_artifact": "forbidden" },
    "same-app-focus": { "classification": "fail_closed", "final_artifact": "forbidden" }
  }
}
